#include "hicma_parsec.h"

/* Operand copy of B(k,n) (see read_B), set by hicma_parsec_trmm_New:
 * 0 none, 1 for the GEMMs on other ranks, 2 converting, for all its GEMMs */
#define TRMM_COPY_B(k, n) (trmm_copy[(size_t)(n) * descB->mt + (k)])

/* Whether dgemm(mm, n, k) reads the copy of B(k,n) rather than B(k,n) itself.
 * With copy 1, the GEMMs whose row is congruent to row k modulo P, on the
 * same rank in a block-cyclic distribution, read B(k,n) in place: dtrmm can
 * then gather their control messages with a strided range. (Any other choice
 * would also be correct, every in-place reader sending one.) */
#define TRMM_READS_COPY(k, n, mm) \
    ( 2 == TRMM_COPY_B(k, n) || (1 == TRMM_COPY_B(k, n) && 0 != ((descB->mt-1-(k)) - (mm)) % P) )

/* Run read_B on the GPU only when its copy converts */
static parsec_hook_return_t trmm_copy_b_evaluate(const parsec_task_t *task);

%}

side      [type = "dplasma_enum_t"]
uplo      [type = "dplasma_enum_t"]
trans     [type = "dplasma_enum_t"]
diag      [type = "dplasma_enum_t"]
alpha     [type = "double"]

descA     [type = "const parsec_tiled_matrix_t*"]
descB     [type = "parsec_tiled_matrix_t*" ]

params_tlr   [ type = "hicma_parsec_params_t *" ]

/* trmm_copy[n*mt+k]: operand copy of B(k,n), see TRMM_COPY_B */
trmm_copy    [ type = "uint8_t *" hidden = on default = NULL ]

/* Process-grid rows: the GEMMs reading a tile of B in place are P rows apart */
P            [ type = "int" hidden = on default = "params_tlr->P" ]

/* Process-grid columns used to rotate the lightweight A-panel credits. */
Q            [ type = "int" hidden = on default = "params_tlr->Q" ]

p_work_full_dp        [ type = "parsec_memory_pool_t *" hidden = on default = NULL ]  /* Double precision full matrix memory pool - allocates memory for dense double precision matrices */
p_work_full_sp        [ type = "parsec_memory_pool_t *" hidden = on default = NULL ]  /* Single precision full matrix memory pool - allocates memory for dense single precision matrices */
p_work_full_hp        [ type = "parsec_memory_pool_t *" hidden = on default = NULL ]  /* Half precision full matrix memory pool - allocates memory for dense half precision matrices */

/* GPU-related variables */
ws_gpu       [ type = "void *" hidden = on default = NULL ]  /* GPU workspace memory - shared workspace for GPU computations across all tasks */
nb_cuda_devices      [ type = "int"   hidden = on default = 0 ]  /* Number of available CUDA devices - tracks how many GPUs are available for computation */
cuda_device_index    [ type = "int *" hidden = on default = "NULL"]  /* Array of CUDA device indices for load balancing - maps tasks to specific GPU devices for optimal load distribution */



/**************************************************
 *               Define Arena                     *
 **************************************************/
/**
 * Arena Definition:
 * The arena defines the data types and memory layouts used throughout the task graph.
 * This arena supports multiple precision formats for mixed precision computation.
 *
 * Memory Layout Strategy:
 * The arena is designed to support seamless precision conversion and efficient
 * memory management across the mixed-precision tiles of the TRMM.
 */
my_arena(k)

// Execution space - single iteration for arena initialization
k = 0 .. 0

// Parallel partitioning - uses the main matrix descriptor for data distribution
:descA(0, 0)

// Parameters - Define data types for different precision formats and operations
READ A1 <- NULL       [ type = FULL_DP ]    /* Double precision full matrix data type - used for critical diagonal computations */
READ A2 <- NULL       [ type = FULL_SP ]    /* Single precision full matrix data type - primary computation format */
READ A3 <- NULL       [ type = FULL_HP ]    /* Half precision full matrix data type - memory-efficient storage */

BODY
{
    /* Arena initialization - no specific initialization needed for this arena
     * The arena serves as a type registry for the PaRSEC runtime to understand
     * the different data types used throughout the task graph execution */
}
END


read_A(m, k) [profile = off]
  /* Execution Space */
  m = 0..(descB->mt-1)
  k = 0..(descB->mt-m-1)

//loc_A = %{ return LOC(descA, (descB->mt-1)-m, k); %}

  /* Locality */
  : descA((descB->mt-1)-m, k)

  READ  A    <- descA((descB->mt-1)-m, k)
             -> (k == (descB->mt-1-m)) ? A dtrmm(m, 0..(descB->nt-1))    [ type_remote = %{ return &__parsec_tp->super.arenas_datatypes[decision_datatype_tile_trmm_mp_LLN(params_tlr, params_tlr->decisions, (descB->mt-1)-m, k, descA->lmt)]; %} ]
             -> (k != (descB->mt-1-m)) ? A dgemm(m, 0..(descB->nt-1), k) [ type_remote = %{ return &__parsec_tp->super.arenas_datatypes[decision_datatype_tile_trmm_mp_LLN(params_tlr, params_tlr->decisions, (descB->mt-1)-m, k, descA->lmt)]; %} ]

  /* Each C chain visits k = i-1, ..., 0, where i = descB->mt-1-m.
   * Leave the diagonal and the first trmm_window off-diagonal tiles ready;
   * a later tile k receives its credit from the earlier GEMM at k+window.
   * The in-place C flow already orders every (m,n) reduction chain.  Use one
   * rotating chain as a soft credit for the next A broadcast instead of
   * gathering completion from every n.  Choosing n from the future panel
   * index normally places the credit on that panel's A-owner process column,
   * avoiding a remote control message as well as the distributed fan-in. */
  CTL   window_A <- (params_tlr->trmm_window > 0 &&
                   k + params_tlr->trmm_window < descB->mt-1-m) ?
                  window_A dgemm(m,
                                 k % (Q < descB->nt ? Q : descB->nt),
                                 k+params_tlr->trmm_window)

BODY
{
    /* nothing */
}
END

/*
 * B(k,n) is read by the GEMMs of the rows below and then overwritten by the
 * TRMM of row k, which must wait until it is no longer needed:
 *  - A GEMM on this rank reads B(k,n) in place and then sends the TRMM a
 *    control message.
 *  - The GEMMs on other ranks read an operand copy (Bop) instead, made here
 *    on the CPU from the host copy and sent from there, so the TRMM does not
 *    wait for remote control messages. (Before, every GEMM reading B(k,n)
 *    sent one, mostly across ranks. Reading the copy on this rank too cost
 *    more: the GPU then had to make and send every copy before any GEMM.)
 *  - With --accumulation_fp32, an FP16 tile stored in FP32 is converted to an
 *    FP16 copy on the GPU, read by all its GEMMs: converted once, and sent in
 *    FP16, instead of converted in every GEMM.
 * hicma_parsec_trmm_New chooses per tile (trmm_copy).
 */
read_B(n, k)
  /* Execution Space */
  n = 0..(descB->nt-1)
  k = 0..(descB->mt-2)

  /* Locality */
  : descB(k,n)

  READ  B    <- descB(k,n)
             -> [ mm = 0 .. descB->mt-k-2 ] (%{ return !TRMM_READS_COPY(k, n, mm); %}) ? B dgemm(mm, n, k)  [ type_remote = %{ return &__parsec_tp->super.arenas_datatypes[decision_datatype_tile_trmm_mp_LLN(params_tlr, params_tlr->decisionsB, k, n, descB->lmt)]; %} ]
  WRITE Bop  <- NEW                                                                     [ type = %{ return &__parsec_tp->super.arenas_datatypes[decision_datatype_tile_trmm_operand_LLN(params_tlr->decisionsB, k, n, descB->lmt)]; %} ]
             -> [ mm = 0 .. descB->mt-k-2 ] (%{ return TRMM_READS_COPY(k, n, mm); %}) ? B dgemm(mm, n, k)   [ type_remote = %{ return &__parsec_tp->super.arenas_datatypes[decision_datatype_tile_trmm_operand_LLN(params_tlr->decisionsB, k, n, descB->lmt)]; %} ]

  /* Bop is write-only so that the GPU allocates it without a transfer; a
   * conditional NEW on a WRITE flow allocates nothing, so it is allocated for
   * every tile and just released when there is no copy. */

  /* B(k,n) is copied: it may be overwritten once its in-place readers are done */
  CTL   ctl0 -> (%{ return TRMM_COPY_B(k, n); %}) ? ctl0 dtrmm(descB->mt-1-k, n)

  /* Just above the GEMMs that read the copy (priority k) */
  ; k + 1

BODY [ type = CUDA evaluate = trmm_copy_b_evaluate ]
{
    int tempnn = ((n)==(descB->nt-1)) ? (descB->n-(n*descB->nb)) : descB->nb;

    /* Remote GEMMs read the host copy */
    for( int j = k+1; j < descB->mt; j++ ) {
        if( descB->super.rank_of(&descB->super, j, n) != descB->super.myrank ) {
            HICMA_PARSEC_GPU_PUSHOUT(gpu_task, "Bop");
            break;
        }
    }
    hicma_parsec_trmm_core_copy_b_gpu( params_tlr, ws_gpu, cuda_device, gpu_task, cuda_stream,
            B, Bop, descB->mb, tempnn, descB->mb, k, n );
}
END

BODY [ type = HIP evaluate = trmm_copy_b_evaluate ]
{
    int tempnn = ((n)==(descB->nt-1)) ? (descB->n-(n*descB->nb)) : descB->nb;

    /* Remote GEMMs read the host copy */
    for( int j = k+1; j < descB->mt; j++ ) {
        if( descB->super.rank_of(&descB->super, j, n) != descB->super.myrank ) {
            HICMA_PARSEC_GPU_PUSHOUT(gpu_task, "Bop");
            break;
        }
    }
    hicma_parsec_trmm_core_copy_b_gpu( params_tlr, ws_gpu, cuda_device, gpu_task, cuda_stream,
            B, Bop, descB->mb, tempnn, descB->mb, k, n );
}
END

BODY
{
    if( TRMM_COPY_B(k, n) ) {
        int tempnn = ((n)==(descB->nt-1)) ? (descB->n-(n*descB->nb)) : descB->nb;
        hicma_parsec_trmm_core_copy_b_cpu( params_tlr, B, Bop, descB->mb, tempnn, descB->mb, k, n );
    }
}
END

dtrmm(m, n) [ flops = inline_c %{ return FLOPS_DTRMM(side, CLEAN_MB(descB, (descB->mt-1)-m), CLEAN_NB(descB, n)); %} ]
  /* Execution Space */
  m = 0..(descB->mt-1)
  n = 0..(descB->nt-1)

//loc_A = %{ return LOC(descA, (descB->mt-1)-m, (descB->mt-1)-m); %}
//loc_B = %{ return LOC(descB, (descB->mt-1)-m, n); %}

  /* Locality */
  : descB((descB->mt-1)-m,n)

  READ  A    <- A read_A(m, descB->mt-1-m)                      [ type_remote = %{ return &__parsec_tp->super.arenas_datatypes[decision_datatype_tile_trmm_mp_LLN(params_tlr, params_tlr->decisions, (descB->mt-1)-m, (descB->mt-1)-m, descA->lmt)]; %} ]
  RW    B    <- descB((descB->mt-1)-m,n)
             -> (m <  (descB->mt-1)) ? C dgemm(m, n, descB->mt-m-2) [ type_remote = %{ return &__parsec_tp->super.arenas_datatypes[decision_datatype_tile_trmm_mp_LLN(params_tlr, params_tlr->decisionsB, (descB->mt-1)-m, n, descB->lmt)]; %} ]
             -> (m == (descB->mt-1)) ? descB((descB->mt-1)-m,n)

  /* Overwrite B(i,n) once its operand copy, if any, is made and every GEMM
   * reading it in place is done (the last row is read by no GEMM) */
  CTL   ctl0 <- (%{ return m > 0 && TRMM_COPY_B(descB->mt-1-m, n); %}) ? ctl0 read_B(n, descB->mt-1-m)
             <- (%{ return m > 0 && 0 == TRMM_COPY_B(descB->mt-1-m, n); %}) ? ctl0 dgemm(0 .. (m-1), n, descB->mt-m-1)
             <- (%{ return m >= P && 1 == TRMM_COPY_B(descB->mt-1-m, n); %}) ? ctl0 dgemm((m % P) .. (m-P) .. P, n, descB->mt-m-1)

  /* Longest chains first: row i then has i GEMMs to go */
  ; descB->mt - m


BODY [ type = CUDA ]
{
    int tempmm = (((descB->mt-1)-m)==(descB->mt-1)) ? (descB->m-(((descB->mt-1)-m)*descB->mb)) : descB->mb;
    int tempnn = ((n)==(descB->nt-1)) ? (descB->n-(n*descB->nb)) : descB->nb;
    int lda = BLKLDD(descA, A);
    int ldb = BLKLDD(descB, B);

    printlog("CORE_dtrmm(%d, %d)\n"
            "\t(side, uplo, trans, diag, tempmm, tempnn, alpha, A(%d,%d)[%p], lda, B(%d,%d)[%p], ldb)\n",
            m, n, (descB->mt-1)-m, (descB->mt-1)-m, A, (descB->mt-1)-m, n, B);

    hicma_parsec_trmm_core_trmm_lln_gpu(
            params_tlr, ws_gpu, cuda_device, gpu_task, cuda_stream,
            side, uplo, trans,
            diag, tempmm, tempnn,
            alpha, A /* descA((descB->mt-1)-m,(descB->mt-1)-m) */, lda,
            B /* descB((descB->mt-1)-m,n) */, ldb,
            m, n );
}
END

