extern "C" %{

/* read_B runs on the GPU only when its copy converts (the local GEMMs then
 * read the copy there); a plain copy is made on the CPU, and without a copy
 * there is no work. */
static parsec_hook_return_t trmm_copy_b_evaluate(const parsec_task_t *task)
{
    const __parsec_trmm_mp_LLN_read_B_task_t *t = (const __parsec_trmm_mp_LLN_read_B_task_t *)task;
    const parsec_trmm_mp_LLN_taskpool_t *tp = (const parsec_trmm_mp_LLN_taskpool_t *)task->taskpool;
    size_t idx = (size_t)t->locals.n.value * tp->_g_descB->mt + t->locals.k.value;
    return (2 == tp->_g_trmm_copy[idx]) ? PARSEC_HOOK_RETURN_DONE : PARSEC_HOOK_RETURN_NEXT;
}

%}
