                 lalpha, (double*)A, lda,
                         (double*)B, ldb,
                 lbeta,  (double*)C, ldc );
    status = cublasGetError();
    PARSEC_CUDA_CHECK_ERROR( "cublasDgemm ", status, {return PARSEC_HOOK_RETURN_ERROR;} );
#endif
}
END

