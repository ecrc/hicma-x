dgemm(m, n, k) [ flops = inline_c %{ return FLOPS_DGEMM(CLEAN_MB(descB, (descB->mt-1)-m), CLEAN_NB(descB, n), descB->mb); %} ]
  /* Execution Space */
  m = 0..(descB->mt-2)
  n = 0..(descB->nt-1)
  k = 0..(descB->mt-m-2)

//loc_A = %{ return LOC(descA, (descB->mt-1)-m,k); %}
//loc_B = %{ return LOC(descB, k, n); %}
//loc_C = %{ return LOC(descB, (descB->mt-1)-m, n); %}

  /* Locality */
  : descB((descB->mt-1)-m,n)

  READ  A    <- A read_A(m, k)                                      [ type_remote = %{ return &__parsec_tp->super.arenas_datatypes[decision_datatype_tile_trmm_mp_LLN(params_tlr, params_tlr->decisions, (descB->mt-1)-m, k, descA->lmt)]; %} ]
  READ  B    <- (%{ return TRMM_READS_COPY(k, n, m); %}) ? Bop read_B(n, k)      [ type_remote = %{ return &__parsec_tp->super.arenas_datatypes[decision_datatype_tile_trmm_operand_LLN(params_tlr->decisionsB, k, n, descB->lmt)]; %} ]
             <- (%{ return !TRMM_READS_COPY(k, n, m); %}) ? B read_B(n, k)        [ type_remote = %{ return &__parsec_tp->super.arenas_datatypes[decision_datatype_tile_trmm_mp_LLN(params_tlr, params_tlr->decisionsB, k, n, descB->lmt)]; %} ]
  /* Consume the nearest preceding B row first, releasing its overwrite
   * dependency early so different output rows can progress concurrently.
   * Keep a single writer for C; descending k changes the summation order. */
  RW    C    <- ((k+m) == (descB->mt-2)) ? B dtrmm(m, n)             [ type_remote = %{ return &__parsec_tp->super.arenas_datatypes[decision_datatype_tile_trmm_mp_LLN(params_tlr, params_tlr->decisionsB, (descB->mt-1)-m, n, descB->lmt)]; %} ]
             <- ((k+m) <  (descB->mt-2)) ? C dgemm(m, n, k+1)
             -> (k >  0) ? C dgemm(m, n, k-1)
             -> (k == 0) ? descB((descB->mt-1)-m,n)

  /* Read in place: B(k,n) may be overwritten once every reader is done */
  CTL   ctl0 -> (%{ return !TRMM_READS_COPY(k, n, m); %}) ? ctl0 dtrmm(descB->mt-k-1, n)

  CTL   window_A -> (params_tlr->trmm_window > 0 &&
                     k >= params_tlr->trmm_window &&
                     n == ((k - params_tlr->trmm_window) %
                           (Q < descB->nt ? Q : descB->nt))) ?
                    window_A read_A(m, k-params_tlr->trmm_window)

  /* Longest chains first: k GEMMs to go after this one */
  ; k


BODY [type=CUDA]
{
    double lalpha = alpha;
    double lbeta = 1.0;
    int tempmm = (((descB->mt-1)-m)==(descB->mt-1)) ? (descB->m-(((descB->mt-1)-m)*descB->mb)) : descB->mb;
    int tempnn = ((n)==(descB->nt-1)) ? (descB->n-(n*descB->nb)) : descB->nb;
    int lda = BLKLDD(descA, A);
    int ldb = BLKLDD(descB, B);
    int ldc = BLKLDD(descB, C);

#if 1
    hicma_parsec_trmm_core_gemm_lln_gpu(
            params_tlr, ws_gpu, cuda_device, gpu_task, cuda_stream,
            trans, dplasmaNoTrans,
            tempmm, tempnn, descB->mb,
            lalpha, A, lda,
            B, ldb, lbeta, C, ldc,
            m, n, k);
#else
