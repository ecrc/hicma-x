#
# find_package(HICMAParsec) configuration. Defines the imported target
# HICMAParsec::hicma_parsec (and HICMAParsec::starsh, HICMAParsec::hcore) and
# locates the packages its headers and link interface need.

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(MPI COMPONENTS C)
find_dependency(PaRSEC)
find_dependency(dplasma)
if(@HICMA_PARSEC_HAVE_CUDA@)
    find_dependency(CUDAToolkit)
endif()
if(@HICMA_PARSEC_HAVE_HIP@)
    find_dependency(hip)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/HICMAParsecTargets.cmake")

set(HICMA_PARSEC_VERSION "@HICMA_PARSEC_VERSION@")
set(HICMA_PARSEC_HAVE_CUDA @HICMA_PARSEC_HAVE_CUDA@)
set(HICMA_PARSEC_HAVE_HIP @HICMA_PARSEC_HAVE_HIP@)
set(HICMA_PARSEC_GENOMICS @HICMA_PARSEC_GENOMICS@)
set_and_check(HICMA_PARSEC_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set_and_check(HICMA_PARSEC_LIBRARY_DIR "@PACKAGE_CMAKE_INSTALL_LIBDIR@")
set(HICMA_PARSEC_LIBRARIES HICMAParsec::hicma_parsec)

check_required_components(HICMAParsec)
