+/* EXPERIMENT (not for commit): HICMA_ACC_MODE selects the FP64 accumulation variant.
+ * 0 scalar loop (as before), 1 AVX, 2 AVX + prefetchnta of C, 3 SGEMM in 256-column panels + mode 2,
+ * 4 AVX + non-temporal stores of C, 5 panels + AVX, 6 panels + NT stores, 7 panels + NT stores except
+ * for the last GEMM of C (k = n-1, whose C the TRSM reads next), 8 panels + scalar loop,
+ * 9 128-column panels + scalar loop */
+#include <immintrin.h>
+static int hicma_acc_mode = -1;
+static inline int hicma_acc_mode_get(void) {
+    if( hicma_acc_mode < 0 ) { const char *s = getenv("HICMA_ACC_MODE"); hicma_acc_mode = s ? atoi(s) : 0; }
+    return hicma_acc_mode;
+}
+__attribute__((target("avx")))
+static void hicma_acc_sub_avx(double *C, const float *W, size_t n, int pf, int nt) {
+    size_t i = 0;
+    if( nt ) while( i < n && ((uintptr_t)(C + i) & 31) ) { C[i] -= W[i]; i++; }
+    for( ; i + 16 <= n; i += 16 ) {
+        if( pf ) {
+            _mm_prefetch((const char *)(C + i) + 1024, _MM_HINT_NTA);
+            _mm_prefetch((const char *)(C + i) + 1024 + 64, _MM_HINT_NTA);
+        }
+        __m256 w0 = _mm256_loadu_ps(W + i), w1 = _mm256_loadu_ps(W + i + 8);
+        __m256d c0 = _mm256_loadu_pd(C + i),     c1 = _mm256_loadu_pd(C + i + 4);
+        __m256d c2 = _mm256_loadu_pd(C + i + 8), c3 = _mm256_loadu_pd(C + i + 12);
+        c0 = _mm256_sub_pd(c0, _mm256_cvtps_pd(_mm256_castps256_ps128(w0)));
+        c1 = _mm256_sub_pd(c1, _mm256_cvtps_pd(_mm256_extractf128_ps(w0, 1)));
+        c2 = _mm256_sub_pd(c2, _mm256_cvtps_pd(_mm256_castps256_ps128(w1)));
+        c3 = _mm256_sub_pd(c3, _mm256_cvtps_pd(_mm256_extractf128_ps(w1, 1)));
+        if( nt ) {
+            _mm256_stream_pd(C + i, c0);     _mm256_stream_pd(C + i + 4, c1);
+            _mm256_stream_pd(C + i + 8, c2); _mm256_stream_pd(C + i + 12, c3);
+        } else {
+            _mm256_storeu_pd(C + i, c0);     _mm256_storeu_pd(C + i + 4, c1);
+            _mm256_storeu_pd(C + i + 8, c2); _mm256_storeu_pd(C + i + 12, c3);
+        }
+    }
+    for( ; i < n; i++ ) C[i] -= W[i];
+    if( nt ) _mm_sfence();
+}
+static void hicma_acc_sub(double *C, const float *W, int mb, int nb, int last) {
+    int mode = hicma_acc_mode_get();
+    if( mode == 0 || mode >= 8 ) {
+        for(int j = 0; j < nb; j++)
+            for(int i = 0; i < mb; i++)
+                C[j*mb+i] -= W[j*mb+i];
+    } else {
+        hicma_acc_sub_avx(C, W, (size_t)mb * nb, mode == 2 || mode == 3,
+                          mode == 4 || mode == 6 || (mode == 7 && !last));
+    }
+}
+/* C(FP64, mb x nb) -= (double)(A * B^T in FP32), W is the FP32 work tile */
+static void hicma_acc_sgemm_sub(int tempmm, int mb, int nb, const float *A, int lda, const float *B, int ldb,
+                                float *W, int ldw, double *C, int last) {
+    int mode = hicma_acc_mode_get();
+    if( mode == 3 || mode >= 5 ) {
+        int pw = mode == 9 ? 128 : 256;
+        for( int j0 = 0; j0 < mb; j0 += pw ) {
+            int w = mb - j0 < pw ? mb - j0 : pw;
+            CORE_sgemm(PlasmaNoTrans, PlasmaTrans, tempmm, w, nb,
+                       (float)1.0, A, lda, B + j0, ldb, (float)0.0, W + (size_t)j0 * ldw, ldw);
+            hicma_acc_sub(C + (size_t)j0 * mb, W + (size_t)j0 * mb, mb, w, last);
+        }
+    } else {
+        CORE_sgemm(PlasmaNoTrans, PlasmaTrans, tempmm, mb, nb,
+                   (float)1.0, A, lda, B, ldb, (float)0.0, W, ldw);
+        hicma_acc_sub(C, W, mb, nb, last);
+    }
+}
